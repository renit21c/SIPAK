# Copy to .env. Bootstrap only runs if no users exist. Choose a unique password (12+ characters).
BOOTSTRAP_EMAIL=admin@sipak.local
BOOTSTRAP_PASSWORD=
BOOTSTRAP_NAME=Administrator SIPAK
DATABASE_URL=sqlite:///./data/sipak.db
# For PostgreSQL (recommended):
# DATABASE_URL=postgresql+psycopg://sipak:CHANGE_ME@localhost:5432/sipak
STORAGE_PATH=data/documents
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
AI_PROVIDER=openrouter
# Choose a model that supports structured_outputs. Set API key only on the backend.
AI_MODEL=
OPENROUTER_API_KEY=
AI_TIMEOUT_SECONDS=180
MAX_UPLOAD_MB=20
# Set true when served over HTTPS.
COOKIE_SECURE=false
